---
import Base from '../layouts/Base.astro';
import openness from '../data/openness.json';
import { displayName, flagEmoji, fmt, scoreParts, searchIndex, tiedRanks } from '../lib/format.ts';
import { averageOpenness, openToAllCount, openToHalfCount, openToNoneCount } from '../lib/doors.ts';
import { absUrl, pageId, ID } from '../lib/seo.ts';
import Flag from '../components/Flag.astro';
const base = import.meta.env.BASE_URL;
const dests = openness.destinations;
// Repeated rank values are real ties and get the same "=" mark as the rankings.
const ties = tiedRanks(dests.map((d) => d.rank));

// The wall's three readings — fully open, majority open, shut — are computed
// from the data so the rail's copy can never drift from the wall it counts.
const scores = dests.map((d) => d.score);
const allCount = openToAllCount(scores);
const halfCount = openToHalfCount(scores);
const noneCount = openToNoneCount(scores);
// The world's average share; the tagline alone says the number. The
// headline carries no datum — the whole phrase is the door, half poured.
const avgOpen = Math.round(averageOpenness(scores));
const tipFor = (d: (typeof dests)[number]) =>
  `${flagEmoji(d.iso2)} ${displayName(d.iso3, d.name)} · openness ${fmt(d.score)} · ${ties.has(d.rank) ? '=' : ''}#${d.rank} of ${dests.length}`;

const rankingId = pageId(Astro.url.pathname, 'ranking');
const itemList = {
  '@type': 'ItemList',
  '@id': rankingId,
  name: 'Destinations by openness',
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: dests.length,
  // subjectOf rather than about, and a list ordinal rather than d.rank — see the note on
  // the same node in index.astro. Openness ranks tie harder still: 199 destinations over
  // 139 distinct ranks.
  subjectOf: { '@id': ID.dataset },
  itemListElement: dests.map((d, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: absUrl(`${base}destination/${d.iso3.toLowerCase()}/`),
    name: `Who can enter ${displayName(d.iso3, d.name)}`,
  })),
};
---
<Base
  title="Openness: which passports get in - Pyatkov Index"
  description="Every destination ranked by the share of the world's people it admits at the border, an eVisa counting a fifth."
  mainEntityId={rankingId}
  jsonld={itemList}
>
  <section class="doors" aria-label="How open the world's destinations are">
    <div class="hero doors-lede">
      <h1>
        <span class="sr-only">Who gets in</span>
        {/* The headline drawn, not set: every letter built from the i's own
            vocabulary — bars with the door's corner, true circles for the
            bowls — and the whole phrase is the door: the glyphs drawn once
            in defs, painted twice — straw, then marigold clipped below one
            waterline through every bowl's center. Half poured, half dry. */}
        <svg class="who-mark" viewBox="0 0 488 97" aria-hidden="true">
          <defs>
            {/* Attributes, not classes, dress the shapes: <use> clones carry
                attributes and inherited properties across, but class-matched
                CSS never reaches the clones. The dry coat's color rides its
                <use> as fill+stroke; a layer is one color, so paint order
                inside it cannot matter. Bars fill; bowls stroke. The poured
                coat is a sea: a wave-topped marigold slab masked to the
                glyphs, forever adrift. A mask, not a clipPath — a mask
                catches the bowls' strokes, and the masked group stays
                rendered, so the slab inside it can animate. */}
            <g id="who-glyphs">
              <g stroke="none">
                <rect x="81" y="0" width="11" height="72" rx="3" />
                <rect x="110" y="40" width="11" height="32" rx="3" />
                <rect x="247" y="20" width="11" height="60" rx="3" />
                {/* The g's crotch, filled flat: the shoulder runs straight
                    from the bowl's top to the stem, so no crack opens where
                    the arc would cross the stem's edge. The stem itself runs
                    long into the hook's stroke for the same reason. */}
                <path d="M 232 20 H 253 V 27 Z" />
                <rect x="270.5" y="40.5" width="41" height="11" />
                <rect x="333" y="6" width="11" height="66" rx="3" />
                <rect x="324" y="20" width="29" height="11" rx="3" />
                <rect x="430" y="20" width="11" height="52" rx="3" />
                <circle cx="435.5" cy="7" r="7" />
                <rect x="448" y="20" width="11" height="52" rx="3" />
                {/* The n's crotch, filled like the g's: stem top and arch
                    apex share y=20, so the dip between them read as a chip,
                    not a shoulder. */}
                <path d="M 451 20 H 468 V 27 Z" />
                <rect x="477" y="40" width="11" height="32" rx="3" />
              </g>
              {/* Round caps: every stroke terminal closes in a half-disc, so
                  arches sit flush on the bars' rounded shoulders, the e's
                  bowl melts into its crossbar, and the open ends — W tips,
                  s, the g's hook — wear the same rounding as the bars. */}
              <g fill="none" stroke-width="11" stroke-linecap="round" stroke-linejoin="round">
                <path d="M 5.5,5.5 L 19.5,66.5 L 37,23 L 54.5,66.5 L 68.5,5.5" />
                <path d="M 86.5,40 A 14.5 14.5 0 0 1 115.5,40" />
                <circle cx="154" cy="46" r="20.5" />
                <circle cx="232" cy="46" r="20.5" />
                <path d="M 252.5,75.5 A 16 16 0 0 1 236.5,91.5" />
                <path d="M 311.5,46 A 20.5 20.5 0 1 0 305.5,60.5" />
                <path d="M 391.2,29.4 A 12.9 12.9 0 0 0 371.6,46 A 12.9 12.9 0 1 1 372.8,62.6" />
                <path d="M 453.5,40 A 14.5 14.5 0 0 1 482.5,40" />
              </g>
            </g>
            <mask id="who-ink" maskUnits="userSpaceOnUse" x="0" y="0" width="488" height="97">
              <use href="#who-glyphs" fill="#fff" stroke="#fff" />
            </mask>
          </defs>
          <use class="mark-dry" href="#who-glyphs" />
          {/* Five wavelengths of sea, one viewport plus one wavelength wide:
              a chain of reflected quadratics swells seven units either side
              of the waterline — deep enough that the crest clears y=40, the
              shelf where arches sit on bars, so no straw hairline ever opens
              at a joint. The drift slides exactly two half-waves, so the
              loop lands on its own shape and never shows a seam. */}
          <g class="who-sea" mask="url(#who-ink)">
            <g class="doorway">
              <path class="mark-poured" d="M 0 46 q 31.3125 -14 62.625 0 t 62.625 0 t 62.625 0 t 62.625 0 t 62.625 0 t 62.625 0 t 62.625 0 t 62.625 0 t 62.625 0 t 62.625 0 V 105 H 0 Z" />
            </g>
          </g>
        </svg>
      </h1>
      <p class="tagline">
        {`Every destination, scored by how much of the world it lets in. The average is ${avgOpen}%.`}
      </p>
      <div class="doors-read">
        <div class="ds ds-all"><span class="ds-plate"><strong>{allCount}</strong></span><span class="ds-label">open to nearly everyone</span></div>
        <div class="ds ds-half"><span class="ds-plate"><strong>{halfCount}</strong></span><span class="ds-label">open to over half the world</span></div>
        <div class="ds ds-none"><span class="ds-plate"><strong>{noneCount}</strong></span><span class="ds-label">open to no one</span></div>
      </div>
    </div>
    <div class="doors-figure">
      <div
        class="doors-wall"
        role="img"
        aria-label={`${dests.length} destinations as doors, sorted from most open to least. Each door's fill is how much of the world it lets in: ${allCount} are open to nearly everyone, ${halfCount} to over half the world, and ${noneCount} to no one.`}
      >
        {dests.map((d, i) => (
          <a
            class:list={['door', d.score > 50 && 'd-half', d.score >= 99.95 && 'd-all', d.score < 0.05 && 'd-none']}
            href={`${base}destination/${d.iso3.toLowerCase()}/`} data-astro-prefetch="false"
            data-tip={tipFor(d)}
            style={`--i:${i};--h:${d.score.toFixed(2)}%`}
          >
            <span class="sr-only">{displayName(d.iso3, d.name)} — openness {fmt(d.score)}</span>
          </a>
        ))}
      </div>
      <div class="ribbon-tip" aria-hidden="true" hidden></div>
    </div>
  </section>

  <div class="card card-mockup">
  <div class="card-header">
    <h2>Every destination, by openness</h2>
    <span class="count">{dests.length} destinations</span>
    <input type="search" id="filter" placeholder="Filter destinations" aria-label="Filter destinations" />
  </div>
  <div class="table-scroll">
  <table id="openness-table" class="rank-table">
    <thead>
      <tr>
        <th scope="col" data-sort="rank" aria-sort="ascending" tabindex="0">#</th>
        <th scope="col" data-sort="name" tabindex="0">Destination</th>
        <th scope="col" data-sort="score" tabindex="0">Openness</th>
      </tr>
    </thead>
    <tbody>
      {dests.map((d) => (
        <tr data-name={displayName(d.iso3, d.name).toLowerCase()} data-search={searchIndex(d)} data-rank={d.rank} data-score={d.score}>
          <td>{ties.has(d.rank) && <span class="tie-mark" aria-hidden="true">=</span>}{d.rank}</td>
          <td><a href={`${base}destination/${d.iso3.toLowerCase()}/`} data-astro-prefetch="false"><Flag iso2={d.iso2} /> {displayName(d.iso3, d.name)}</a><span class="code" aria-hidden="true">{d.iso3}</span></td>
          <td class="score-cell">{scoreParts(d.score).int}<span class="dec">.{scoreParts(d.score).dec}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
  </div>
  <p id="no-results" hidden>No destinations match your filter. Try a country name like Japan, or a code like JPN.</p>
  </div>

  <script>
    import { initSortableTable } from '../lib/table-ui.ts';
    import { initRibbonTip } from '../lib/ribbon-tip.ts';

    // Module scripts run once per session under the client router; page-load
    // fires again after every swap, re-binding against the fresh DOM. On other
    // pages the element guards make these calls no-ops.
    document.addEventListener('astro:page-load', () => {
      initRibbonTip({ figure: '.doors-figure', ribbon: '.doors-wall', tip: '.doors-figure .ribbon-tip' });
      initSortableTable({
        table: '#openness-table',
        filter: '#filter',
        noResults: '#no-results',
        initialSort: 'rank',
        defaultAsc: { rank: true, name: true, score: false },
      });
    });
  </script>

  <style>
    /* global.css carries no visually-hidden utility; the doors' anchor text
       needs one, defined here next to its only users — the same arrangement
       as the front page's ribbon. */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  </style>
</Base>
