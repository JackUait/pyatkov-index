---
import Base from '../layouts/Base.astro';
import rankings from '../data/rankings.json';
import weights from '../data/weights.json';
import { displayName, flagEmoji, scoreParts, searchIndex, tiedRanks, withArticle } from '../lib/format.ts';
import { RIBBON_FAINT, TAIL_FAINT, tailShade, weightShade } from '../lib/weight-shade.ts';
import { absUrl, pageId, ID } from '../lib/seo.ts';
import Flag from '../components/Flag.astro';
import RowActions from '../components/RowActions.astro';
const base = import.meta.env.BASE_URL;

// The hero graphic is the argument: every destination drawn to scale by its
// weight, heaviest first. Weights are raw signal sums, not percentages, so
// each one is expressed as a share of the total before it is drawn.
const ribbon = [...weights.destinations].sort((a, b) => b.weight - a.weight);
const totalWeight = ribbon.reduce((sum, d) => sum + d.weight, 0);
const share = (w: number) => (w / totalWeight) * 100;
// How few destinations it takes to reach half the world's weight, computed
// rather than hard-coded so the caption cannot drift from the data.
let running = 0;
let halfCount = 0;
for (const d of ribbon) {
  running += d.weight;
  halfCount += 1;
  if (running >= totalWeight / 2) break;
}
// Where the heavy head ends, as a share of the strip's width: the bracket
// annotation is anchored to this so it always measures the marigold block.
const halfShare = share(running);
// Only the extreme gets an in-mark label; anything narrower can't fit one.
const labelShare = 4;
// Two inks, the logotype's law: the heavy half runs the amber ramp, the tail
// the neutral one, and the boundary at halfShare is a step between them.
// Build-time hex, so no slat pays for color math at runtime.
//
// The two halves earn their shade differently because their weights are shaped
// differently. Across the head, weight falls off steeply enough to drive the
// ramp itself: strength is the square root of the slat's share of the heaviest,
// which stretches the near-misses apart. The tail is 166 destinations packed
// into a range so narrow that the same rule paints them all one flat gray —
// there, order is the only signal left, so strength is the slat's place in the
// tail, decaying evenly from the boundary to the last slat on the strip. The
// ramp itself quantizes that into bands, so the decay reads as steps.
const maxShare = share(ribbon[0].weight);
const tailCount = ribbon.length - halfCount;
const shadeFor = (w: number, i: number) =>
  i < halfCount
    ? weightShade(Math.sqrt(share(w) / maxShare))
    : tailShade(1 - (i - halfCount) / (tailCount - 1));
// The phone legend keys each caption with the shade of its group's median
// destination, so the swatches follow the data instead of naming two fills.
const headMedian = Math.floor(halfCount / 2);
const tailMedian = halfCount + Math.floor((ribbon.length - halfCount) / 2);
const headSwatch = shadeFor(ribbon[headMedian].weight, headMedian);
const tailSwatch = shadeFor(ribbon[tailMedian].weight, tailMedian);
const tipFor = (d: (typeof ribbon)[number], i: number) =>
  `${flagEmoji(d.iso2)} ${displayName(d.iso3, d.name)} · ${share(d.weight).toFixed(2)}% of world weight · #${i + 1} of ${ribbon.length}`;
// Shared ranks are real ties, and the table says so: repeated rank values get
// an "=" mark, computed from the data so it can never drift from it.
const ties = tiedRanks(rankings.passports.map((p) => p.rank));

const rankingId = pageId(Astro.url.pathname, 'ranking');
// position is the array index, not p.rank. The ties are real and the visible table marks
// them, but an ItemList position is a list ordinal, not a score: feeding it p.rank
// declared numberOfItems: 199 alongside 22 duplicated positions, 37 unused ones and a
// maximum of 162, which no consumer can reconcile.
const itemList = {
  '@type': 'ItemList',
  '@id': rankingId,
  name: 'Passport rankings by Pyatkov score',
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: rankings.passports.length,
  // subjectOf, not about: `about` domainIncludes CreativeWork and Event, and an ItemList
  // is an Intangible. subjectOf runs the other way — domain Thing, range CreativeWork —
  // and a Dataset is a CreativeWork, so it states the same link legally.
  subjectOf: { '@id': ID.dataset },
  itemListElement: rankings.passports.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: absUrl(`${base}passport/${p.iso3.toLowerCase()}/`),
    name: `${displayName(p.iso3, p.name)} passport`,
  })),
};
---
<Base
  title="Pyatkov Index: the weighted passport ranking"
  description="A passport index that weights every destination by the economy, travel, development, and diaspora behind it."
  mainEntityId={rankingId}
  jsonld={itemList}
>
  <section class="hero hero-split">
    <h1>
      Most rankings <span class="count-word"><span class="sr-only">count</span><span class="count-letters" aria-hidden="true"><i>c</i><i>o</i><i>u</i><i>n</i><i>t</i></span></span><br />
      This one <span class="block-word">weighs</span>
    </h1>
    <p class="tagline">
      We score each destination by its economy, travel, development, and
      diaspora, then rank each passport by how much it can actually reach.
    </p>
  </section>

  <figure
    class="ribbon-figure"
    style={`--half:${halfShare.toFixed(2)}%;--ribbon-faint:${RIBBON_FAINT};--tail-faint:${TAIL_FAINT}`}
  >
    <figcaption class="ribbon-annot">
      <span class="annot-half" style={`--swatch:${headSwatch}`}><b>{halfCount} destinations</b> carry half the world's weight</span>
      <span class="annot-tail" style={`--swatch:${tailSwatch}`}>the other <b>{ribbon.length - halfCount}</b> share the rest</span>
      <i class="annot-bracket" aria-hidden="true"></i>
    </figcaption>
    <div
      class="ribbon"
      role="img"
      aria-label={`All ${ribbon.length} destinations drawn to scale by weight, heaviest first. ${displayName(ribbon[0].iso3, ribbon[0].name)} is the heaviest at ${share(ribbon[0].weight).toFixed(1)} percent of the world total; the ${halfCount} heaviest together carry half of it, and the remaining ${ribbon.length - halfCount} share the rest.`}
    >
      {ribbon.map((d, i) => (
        <a
          class="seg"
          href={`${base}destination/${d.iso3.toLowerCase()}/`} data-astro-prefetch="false"
          data-tip={tipFor(d, i)}
          style={`--w:${share(d.weight).toFixed(4)}%;--c:${shadeFor(d.weight, i)}`}
        >
          {share(d.weight) >= labelShare && (
            <span class="seg-label"><b>{d.iso2}</b><span>{share(d.weight).toFixed(1)}%</span></span>
          )}
          <span class="sr-only">{displayName(d.iso3, d.name)} — {share(d.weight).toFixed(2)}% of world weight</span>
        </a>
      ))}
    </div>
    <div class="ribbon-tip" aria-hidden="true" hidden></div>
  </figure>

  <div class="card card-mockup" id="rankings-card">
  <div class="card-header">
    <h2>Passport ranking</h2>
    <input type="search" id="filter" placeholder="Filter countries" aria-label="Filter countries" />
  </div>
  <div class="table-scroll">
  <table id="rankings" class="rank-table">
    <thead>
      <tr>
        <th scope="col" data-sort="rank" aria-sort="ascending" tabindex="0">#</th>
        <th scope="col" data-sort="name" tabindex="0">Passport</th>
        <th scope="col" data-sort="score" tabindex="0">Score</th>
        <th scope="col"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      {rankings.passports.map((p) => (
        <tr data-name={displayName(p.iso3, p.name).toLowerCase()} data-search={searchIndex(p)} data-rank={p.rank} data-score={p.score}>
          <td>{ties.has(p.rank) && <span class="tie-mark" aria-hidden="true">=</span>}{p.rank}</td>
          <td><a href={`${base}passport/${p.iso3.toLowerCase()}/`} data-astro-prefetch="false"><Flag iso2={p.iso2} /> {displayName(p.iso3, p.name)}</a><span class="code" aria-hidden="true">{p.iso3}</span></td>
          <td class="score-cell">{scoreParts(p.score).int}<span class="dec">.{scoreParts(p.score).dec}</span></td>
          <RowActions
            kind="passport"
            iso3={p.iso3}
            iso2={p.iso2}
            name={displayName(p.iso3, p.name)}
            article={withArticle(p.iso3, p.name)}
            rank={p.rank}
            score={p.score}
            tied={ties.has(p.rank)}
            href={`${base}passport/${p.iso3.toLowerCase()}/`}
          />
        </tr>
      ))}
    </tbody>
  </table>
  </div>
  <p id="no-results" hidden>No passports match your filter. Try a country name like Portugal, or a code like PRT.</p>
  </div>

  <script>
    import { initSortableTable } from '../lib/table-ui.ts';
    import { initTableActions } from '../lib/table-actions.ts';
    import { initRibbonTip } from '../lib/ribbon-tip.ts';
    import { initCountScramble } from '../lib/count-scramble.ts';

    // Module scripts run once per session under the client router; page-load
    // fires again after every swap, re-binding against the fresh DOM. On other
    // pages the element guards make these calls no-ops.
    document.addEventListener('astro:page-load', () => {
      initCountScramble();
      initRibbonTip({ figure: '.ribbon-figure', ribbon: '.ribbon', tip: '.ribbon-tip' });
      initSortableTable({
        table: '#rankings',
        filter: '#filter',
        noResults: '#no-results',
        initialSort: 'rank',
        defaultAsc: { rank: true, name: true, score: false },
      });
      initTableActions({ table: '#rankings', card: '#rankings-card', kind: 'passport' });
    });
  </script>

  <style>
    /* global.css carries no visually-hidden utility, so the one the ribbon's
       anchor text and the headline's counted word need is defined here, next
       to its only users. */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  </style>
</Base>
