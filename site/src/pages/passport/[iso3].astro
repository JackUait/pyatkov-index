---
import Base from '../../layouts/Base.astro';
import rankings from '../../data/rankings.json';
import openness from '../../data/openness.json';
import weightsData from '../../data/weights.json';
import matrix from '../../data/matrix.json';
import { bareName, displayName, fmt, reconcilePoints, searchIndex, withArticle } from '../../lib/format.ts';
import { CREDIT, LABEL, TIERS, type Tier } from '../../lib/credit.ts';
import { hundredCells } from '../../lib/hundred.ts';
import { ID, pageId } from '../../lib/seo.ts';
import { countryNode } from '../../lib/schema.ts';
import updates from '../../data/updates.json';
import { passportLede, passportLine, passportNews, stampLabel } from '../../lib/country-news.ts';
import { accessPhrase, sourceHost, tierClass } from '../../lib/updates-copy.ts';
import Flag from '../../components/Flag.astro';

export function getStaticPaths() {
  return rankings.passports.map((p) => ({ params: { iso3: p.iso3.toLowerCase() }, props: { passport: p } }));
}

const { passport: p } = Astro.props;
const base = import.meta.env.BASE_URL;
const access = (matrix as Record<string, Record<string, string>>)[p.iso3];

// Foreign destinations only (exclude the home country) — used for the two
// "heaviest doors" lists, which shouldn't list the passport itself.
const foreignDests = weightsData.destinations
  .filter((d) => d.iso3 !== p.iso3)
  .map((d) => ({ ...d, category: access[d.iso3] as Tier, contribution: CREDIT[access[d.iso3] as Tier] * d.weight }));
// Three doors, keyed by HOW entry is decided rather than the tier name: a BORDER decision
// (visa-free / on arrival, full credit), a CONDITIONAL one (an eVisa — approval that must
// clear before you fly, worth a fifth), and a closed one (a visa arranged in advance, no
// credit). The score bar and the three door lists all read off this split.
const isBorder = (c: Tier) => CREDIT[c] === 1;
const isConditional = (c: Tier) => CREDIT[c] > 0 && CREDIT[c] < 1;
const open = foreignDests.filter((d) => isBorder(d.category));
const openSorted = [...open].sort((a, b) => b.contribution - a.contribution);
const topOpen = openSorted.slice(0, 10);
const missing = foreignDests.filter((d) => CREDIT[d.category] === 0); // already weight-desc
const topMissing = missing.slice(0, 10);
// Self-inclusion, consistent with the pipeline score: the home country is counted
// as a visa-free destination in BOTH numerator and denominator, so the tier points
// (which include the home country's own weight in the visa-free tier) sum to p.score
// before rounding, over the full destination pool.
const totalWeight = weightsData.destinations.reduce((a, d) => a + d.weight, 0);
const ownWeight = weightsData.destinations.find((d) => d.iso3 === p.iso3)?.weight ?? 0;
const denom = totalWeight;
const rawPoints = TIERS.map((cat) => {
  // The home country contributes its own weight to the visa-free tier (self-inclusion).
  const selfContribution = cat === 'visa-free' ? ownWeight : 0;
  const foreign = foreignDests.filter((d) => d.category === cat).reduce((a, d) => a + d.contribution, 0);
  return (100 * (foreign + selfContribution)) / denom;
});
// B5: round the tier points so they sum exactly to the displayed Score.
const reconciled = reconcilePoints(rawPoints, p.score);
const tierContribution = TIERS.map((cat, i) => ({
  cat,
  points: reconciled[i],
  count: p.counts[cat as keyof typeof p.counts],
}));

const name = displayName(p.iso3, p.name);
// The name where it lands after a preposition ("who can enter …"), which is where
// "enter United States" reads as a template tell.
const theName = withArticle(p.iso3, p.name);
// And the form for the slot that writes its own "The" — otherwise BHS and GMB,
// whose display names carry an article, read "The The Bahamas passport".
const bare = bareName(p.iso3, p.name);
const total = rankings.passports.length;

// Where a destination sits in the weight table, for the mirror statline.
const weightRank = (iso3: string) => weightsData.destinations.findIndex((w) => w.iso3 === iso3) + 1;
// Weight as points: a border-open destination's share of the total weight is exactly what
// it pays into the score — or, for a closed door, what it would pay if it opened.
const sharePoints = (weight: number) => fmt((100 * weight) / denom);
// The spread rules both pages to one baseline: the shorter list keeps blank
// ledger rows until the columns stand equally tall.
const blankRows = (n: number) => Math.max(topOpen.length, topMissing.length) - n;
// The row tooltip's gloss per tier, in the methodology's words — the only
// place the spread explains its swatches now that the legend is gone.
const ACCESS_NOTE: Record<Tier, string> = {
  'visa-free': 'entry decided at the border',
  'visa-on-arrival': 'no approval needed before you fly',
  'e-visa': 'approval clears before you fly, a fifth of credit',
  'visa-required': 'arranged in advance, earns no credit',
};

// Score anatomy bar spanning 100: each earning tier at its (reconciled) points, then one
// locked segment for everything withheld (100 − score). The eVisa tier shows only the
// fifth it earns; its withheld four-fifths fold into the locked block.
const borderPoints = tierContribution.filter((t) => isBorder(t.cat)).reduce((a, t) => a + t.points, 0);
const conditionalPoints = tierContribution.filter((t) => isConditional(t.cat)).reduce((a, t) => a + t.points, 0);
const locked = Math.max(0, 100 - p.score);
const segments = [
  ...tierContribution.filter((t) => CREDIT[t.cat] > 0).map((t) => ({ cat: t.cat, share: t.points })),
  { cat: 'visa-required' as Tier, share: locked },
].filter((s) => s.share > 0.05);
const barLabel = [
  `at the border: ${fmt(borderPoints)} points`,
  ...(conditionalPoints > 0.05 ? [`by eVisa: ${fmt(conditionalPoints)} points`] : []),
  ...(locked > 0.05 ? [`locked: ${fmt(locked)} points`] : []),
].join(', ');

// The doors that matter most, pulled out as cards.
const best = topOpen[0];
const gap = topMissing[0];

// The mirror view: how the country does as a destination. On near-identical
// passports (the Schengen pairs) this is where the numbers actually diverge.
const ownDest = openness.destinations.find((x) => x.iso3 === p.iso3);

const countryId = pageId(Astro.url.pathname, 'country');
const country = countryNode({
  id: countryId,
  name,
  iso3: p.iso3,
  iso2: p.iso2,
  // Names and propertyIDs are qualified with "passport": the destination page emits a
  // Country node for the same country carrying its OWN count rank and delta, and a
  // consumer merging the two graphs by property name would otherwise read the passport's
  // #76 and the destination's #1 as two values of one thing.
  measures: [
    { propertyID: 'pyatkov-score', name: 'Pyatkov score', value: Number(fmt(p.score)), minValue: 0, maxValue: 100 },
    { propertyID: 'passport-rank', name: 'Passport rank', value: p.rank },
    { propertyID: 'passport-count-rank', name: 'Passport count rank', value: p.equalRank },
    { propertyID: 'passport-delta', name: 'Passport delta from weighting', value: p.delta },
  ],
});

// The spread's figure: the score as 100 point-squares, one per hundredth of
// the weighted world — earned marigold from the floor up, locked gray ceiling.
const hundred = hundredCells(p.score);

// The changelog, asked only what it says about this passport. Most passports were never
// touched, so the section has to read as well empty as full.
const news = passportNews(updates, p.iso3);
---
<Base
  title={`${name} passport - Pyatkov Index`}
  description={`${name} passport: rank #${p.rank} of ${total}, score ${fmt(p.score)}/100. Visa-free to ${p.counts['visa-free']}, on arrival to ${p.counts['visa-on-arrival']}; ${p.counts['e-visa']} eVisa count a fifth and ${p.counts['visa-required']} visa-required count as closed.`}
  ogType="article"
  breadcrumb={[{ name: 'Passports', href: base }, { name: `${name} passport` }]}
  mainEntityId={countryId}
  basedOnId={ID.dataset}
  jsonld={country}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={base}>Passports</a> <span aria-hidden="true">/</span> <span aria-current="page">{name} passport</span>
  </nav>

  {/* The passport spread: identity and the two numerals on the left, the
      hundred — the score drawn as point-squares — rising on the right. A
      <section>, not <header>: the global header rule is sticky chrome. */}
  <section class="pass-spread">
    <div class="pass-lede">
      <Flag iso2={p.iso2} class="pass-flag" />
      <h1>The {bare} passport</h1>
      <div class="pass-figures">
        <p><strong>#{p.rank}</strong> <span>of {total} passports</span></p>
        <p><strong>{fmt(p.score)}</strong> <span>of 100 points</span></p>
      </div>
    </div>
    <div
      class="pass-hundred"
      role="img"
      aria-label={`The score as 100 squares: ${fmt(p.score)} earned, ${fmt(locked)} locked.`}
    >
      {hundred.map((c) => (
        <i class={c.kind === 'gold' ? undefined : `hc-${c.kind}`} style={`--i:${c.i}${c.kind === 'part' ? `;--part:${c.part}` : ''}`} />
      ))}
    </div>
  </section>

  <h2>Where the score comes from</h2>
  <div class="card">
    <div class="score-anatomy">
      <div class="bar-annot">
        <span><b>{fmt(borderPoints)}</b> at the border</span>
        {conditionalPoints > 0.05 && <span><b>+{fmt(conditionalPoints)}</b> by eVisa</span>}
        {locked > 0.05 && <span><b>{fmt(locked)}</b> locked</span>}
      </div>
      <div class="score-bar" role="img" aria-label={barLabel}>
        {segments.map((s) => (
          <i class={`tier-${s.cat}`} style={`--share:${s.share.toFixed(2)}`} />
        ))}
      </div>
    </div>
    <div class="table-scroll">
      <table class="tier-table">
        <caption class="sr-only">How {name}'s score of {fmt(p.score)} splits across the four access tiers</caption>
        <thead><tr><th scope="col">Access tier</th><th scope="col">Destinations</th><th scope="col">Points</th></tr></thead>
        <tbody>
          {tierContribution.map((t) => (
            <tr><td><span class={`tier-key tier-${t.cat}`}>{LABEL[t.cat]}</span></td><td>{t.count}</td><td>{fmt(t.points)}</td></tr>
          ))}
        </tbody>
        <tfoot>
          <tr><th scope="row">Total (Score)</th><td>{p.counts['visa-free'] + p.counts['visa-on-arrival'] + p.counts['e-visa'] + p.counts['visa-required']}</td><td>{fmt(p.score)}</td></tr>
        </tfoot>
      </table>
    </div>
  </div>

  <div class="hl-grid">
    {best && (
      <div class="hl-card hl-open">
        <span class="hl-label">Best open door</span>
        <a class="hl-name" href={`${base}destination/${best.iso3.toLowerCase()}/`} data-astro-prefetch="false"><Flag iso2={best.iso2} /> {displayName(best.iso3, best.name)}</a>
        <span class={`tier-key tier-${best.category}`}>{LABEL[best.category]}</span>
        <span class="hl-pts"><b>{sharePoints(best.weight)}</b> points of the score</span>
      </div>
    )}
    <div class="hl-card hl-locked">
      {gap ? (
        <Fragment>
          <span class="hl-label">Costliest closed door</span>
          <a class="hl-name" href={`${base}destination/${gap.iso3.toLowerCase()}/`} data-astro-prefetch="false"><Flag iso2={gap.iso2} /> {displayName(gap.iso3, gap.name)}</a>
          <span class={`tier-key tier-${gap.category}`}>{LABEL[gap.category]}</span>
          <span class="hl-pts"><b>+{sharePoints(gap.weight)}</b> points if it opened</span>
        </Fragment>
      ) : (
        <Fragment>
          <span class="hl-label">Nothing closed</span>
          <p class="hl-none">Every weighted destination admits {name} holders without prior permission.</p>
        </Fragment>
      )}
    </div>
  </div>

  <div class="rank-cols">
    <section class="ledger-page">
      <h2>The biggest open doors</h2>
      <ol class="rank-list">
        {topOpen.map((d) => (
          <li class={`tier-${d.category}`}>
            <a href={`${base}destination/${d.iso3.toLowerCase()}/`} data-astro-prefetch="false"><Flag iso2={d.iso2} /> {displayName(d.iso3, d.name)}<i class="door-how" aria-hidden="true"></i></a>
            <b class="wt-val"><span class="sr-only">{LABEL[d.category]}, </span>{sharePoints(d.weight)}</b>
            <span class="rank-tip" aria-hidden="true"><i class="door-how"></i><span><b>{LABEL[d.category]}</b> — {ACCESS_NOTE[d.category]}</span></span>
          </li>
        ))}
        {Array.from({ length: blankRows(topOpen.length) }).map(() => <li class="rank-blank" aria-hidden="true"><span class="wt-val">&nbsp;</span></li>)}
      </ol>
    </section>
    <section class="ledger-page ledger-locked">
      <h2>The biggest closed doors</h2>
      {topMissing.length === 0 ? (
        <p class="list-intro">None — this passport reaches every weighted destination.</p>
      ) : (
        <Fragment>
          {/* One tier fills this whole page of the ledger — the rows carry
              no swatches, their rules run dashed like the map's closed-door
              chips, and the column reads locked-gray against the open
              page's inks. */}
          <ol class="rank-list">
            {topMissing.map((d) => (
              <li class={`tier-${d.category}`}>
                <a href={`${base}destination/${d.iso3.toLowerCase()}/`} data-astro-prefetch="false"><Flag iso2={d.iso2} /> {displayName(d.iso3, d.name)}</a>
                <b class="wt-val">+{sharePoints(d.weight)}</b>
                <span class="rank-tip" aria-hidden="true"><span><b>{LABEL[d.category]}</b> — {ACCESS_NOTE[d.category]}</span></span>
              </li>
            ))}
            {Array.from({ length: blankRows(topMissing.length) }).map(() => <li class="rank-blank" aria-hidden="true"><span class="wt-val">&nbsp;</span></li>)}
          </ol>
        </Fragment>
      )}
    </section>
  </div>

  <div class="dest-map-head">
    <h2>Every destination</h2>
    <input
      id="dest-search"
      class="dest-search"
      type="search"
      placeholder={`Search ${foreignDests.length} destinations`}
      aria-label="Search destinations"
      autocomplete="off"
    />
  </div>
  <div class="dest-map">
    {TIERS.map((cat) => {
      // Heaviest first, not A–Z: within a tier the order then says which doors
      // carry the score. foreignDests inherits weights.json's weight-desc order.
      const items = foreignDests
        .filter((d) => d.category === cat)
        .map((d) => ({ ...d, label: displayName(d.iso3, d.name) }));
      const points = tierContribution.find((t) => t.cat === cat)?.points ?? 0;
      return (
        items.length > 0 && (
          <section class={`dest-group tier-${cat}`}>
            <header class="dest-head">
              <h3 class={`tier-key tier-${cat}`}>{LABEL[cat]} <span class="count">{items.length}</span></h3>
              <span class="dest-pts"><b>{fmt(points)}</b> points</span>
            </header>
            <ul class={`dest-flow tier-${cat}${CREDIT[cat] > 0 ? '' : ' is-locked'}`}>
              {items.map((d) => (
                <li data-search={searchIndex(d)}><a href={`${base}destination/${d.iso3.toLowerCase()}/`} data-astro-prefetch="false"><Flag iso2={d.iso2} /> {d.label}</a></li>
              ))}
            </ul>
          </section>
        )
      );
    })}
    <p class="dest-empty" hidden>No destination matches that search.</p>
  </div>

  {ownDest && (
    <Fragment>
      <h2>As a destination</h2>
      <div class="statline">
        <div><strong>#{weightRank(p.iso3)}</strong> <span>heaviest in the index · weight {ownWeight.toFixed(3)}</span></div>
        <div><strong>#{ownDest.rank}</strong> <span>most open of {openness.destinations.length}</span></div>
        <div><strong>{fmt(ownDest.score)}</strong> <span>openness score / 100</span></div>
        <div class="stat-end"><a href={`${base}destination/${p.iso3.toLowerCase()}/`} data-astro-prefetch="false">Who can enter {theName} →</a></div>
      </div>
    </Fragment>
  )}

  {/* The ledger's own account of this passport. One line per policy, stamped with the day
      it took effect and the government that settles it — the changelog's substance without
      the changelog's cards, because a country page has only a handful of rows to set. */}
  <section class="cnews" aria-label={`Changes affecting the ${bare} passport`}>
    <h2>What changed for this passport</h2>
    <p class="cnews-lede">{passportLede(updates, news)}</p>

    {news.events.length > 0 && (
      <ol class="cnews-log">
        {news.events.map((e) => (
          <li class={`cnews-row is-${e.direction}`}>
            <time datetime={e.effective}>{stampLabel(e.effective)}</time>
            <div class="cnews-say">
              <a class="cnews-line" href={`${base}destination/${e.destination.iso3.toLowerCase()}/`} data-astro-prefetch="false">
                <Flag iso2={e.destination.iso2} />{passportLine(e)}
              </a>
              <p class="cnews-shift">
                <span class={`tier-key ${tierClass(e.from)}`}>{accessPhrase(e.from)}</span>
                <span class="cnews-arrow" aria-hidden="true">→</span>
                <span class={`tier-key ${tierClass(e.to)}`}>{accessPhrase(e.to)}</span>
                {e.sunset && <span class="cnews-sunset">lapses {stampLabel(e.sunset)}</span>}
              </p>
            </div>
            <a class="cnews-src" href={e.source} rel="nofollow noopener" target="_blank">
              {sourceHost(e.source)}<span aria-hidden="true"> ↗</span>
              <span class="sr-only"> — source for this change, opens in a new tab</span>
            </a>
          </li>
        ))}
      </ol>
    )}

    <p class="cnews-all">
      <a href={`${base}updates/`}>All {updates.totals.events} corrections across the index →</a>
    </p>
  </section>

  <style>
    .crumbs {
      font-size: 13px;
      color: var(--color-graphite);
      margin-bottom: 12px;
    }
    .crumbs span { margin: 0 6px; }
    .crumbs [aria-current] { margin: 0; }
    .list-intro {
      font-size: 14px;
      color: var(--color-graphite);
      max-width: 46ch;
    }
    /* Captions are indexable text, but the tables are already titled by their h2. */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }
  </style>

  {/* astro:page-load fires on the initial load too (ClientRouter), so one
      listener covers first paint and every view transition. In the drawer the
      page's scripts arrive inert; country-drawer.ts re-runs the init there. */}
  <script>
    import { initDestSearch } from '../../lib/dest-search.ts';
    import { initRankTip } from '../../lib/rank-tip.ts';
    document.addEventListener('astro:page-load', () => {
      initDestSearch();
      initRankTip();
    });
  </script>
</Base>
